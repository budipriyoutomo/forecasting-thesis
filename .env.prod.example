# Konfigurasi deployment VPS. Salin ke `.env.prod` di server lalu isi.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# File ini dibaca oleh compose (interpolasi ${...}) DAN diteruskan ke container
# backend sebagai environment. `.env.prod` masuk .gitignore — jangan di-commit.

# --- Domain & TLS ---
DOMAIN=forecastiq.example.com
TLS_EMAIL=admin@example.com

# --- Runtime backend ---
ENVIRONMENT=production
# Same-origin lewat Caddy, jadi CORS praktis tak terpakai. Isi tetap agar eksplisit.
CORS_ORIGINS=https://forecastiq.example.com
UVICORN_WORKERS=2

# --- Auth ---
# WAJIB diganti. Bikin dengan: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
# DEV_AUTH otomatis mati kalau ENVIRONMENT != development — jangan diaktifkan di sini.
DEV_AUTH_ENABLED=false

# --- Database ---
# Bikin dengan: openssl rand -base64 24
POSTGRES_USER=forecastiq
POSTGRES_PASSWORD=
POSTGRES_DB=forecastiq
# Host `postgres` = nama service di compose. Kalau pakai Supabase, ganti seluruh URL
# ini dan hapus service postgres dari docker-compose.prod.yml.
DATABASE_URL=postgresql+asyncpg://forecastiq:GANTI_PASSWORD@postgres:5432/forecastiq

# --- Supabase Auth (WAJIB) ---
# Tanpa ini tak ada satu pun user yang bisa login di production: dev_auth mati,
# dan SupabaseAuthenticator raise 503.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Object storage IDCloudHost (WAJIB untuk upload & export) ---
S3_ENDPOINT_URL=https://is3.cloudhost.id
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=SouthJkt-a
S3_BUCKET_NAME=forecastiq-bucket
S3_ADDRESSING_STYLE=auto

# --- Frontend (di-inline saat build image — ubah nilai = wajib `--build` ulang) ---
NEXT_PUBLIC_API_URL=https://forecastiq.example.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Upload & forecasting ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_MIN_ROWS=10
FORECAST_ENGINES_ENABLED=moving_average,exponential_smoothing,random_forest,xgboost
FORECAST_RANKING_METRIC=mape
COMPUTE_MASE=true
BACKTEST_MIN_PERIODS=12
LSTM_MIN_PERIODS=24
MOVING_AVERAGE_WINDOW=3
ENGINE_TIMEOUT_SECONDS=45
LSTM_ENGINE_TIMEOUT_SECONDS=120
FORECAST_TIMEOUT_SECONDS=180

# --- Inventory & gudang (WAJIB > 0, kalau nol EOQ & cost summary tampil 0) ---
SERVICE_LEVEL_Z=1.65
DEFAULT_ORDERING_COST=750000
DEFAULT_HOLDING_COST_RATE=25
WAREHOUSE_PALLET_NO_RACKING=true
