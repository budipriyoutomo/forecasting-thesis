# Runtime
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Auth
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_MIN_ROWS=10

# Forecasting engine v3.0 — Comparative Selection (Fase 4)
FORECAST_ENGINES_ENABLED=moving_average,exponential_smoothing,random_forest,xgboost,lstm
FORECAST_RANKING_METRIC=mape          # mape | mad | mse | mfe_abs — terendah menang
COMPUTE_MASE=true                     # hitung & simpan MASE tambahan (bukan buat ranking)
BACKTEST_MIN_PERIODS=12
LSTM_MIN_PERIODS=24
MOVING_AVERAGE_WINDOW=3
ENGINE_TIMEOUT_SECONDS=45             # konvensional & tree-based
LSTM_ENGINE_TIMEOUT_SECONDS=120       # LSTM butuh timeout lebih longgar
FORECAST_TIMEOUT_SECONDS=180

# Engine legacy v2.0 (nonaktif default — docs/ARCHITECTURE.md §6.9)
SCORING_WEIGHT_MASE=0.6
SCORING_WEIGHT_GUARDRAIL=0.3
SCORING_WEIGHT_FIT=0.1

# Reorder / EOQ & total cost (Fase 5)
SERVICE_LEVEL_Z=1.65
DEFAULT_ORDERING_COST=0
DEFAULT_HOLDING_COST_RATE=0

# Warehouse capacity constraint (Fase 6)
WAREHOUSE_PALLET_NO_RACKING=true

# Database (Fase 1+)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/forecastiq

# Supabase (Fase 1+)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (Fase 3+)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=forecastiq-bucket
