# Runtime
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Auth
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_MIN_ROWS=10

# Forecasting engine (Fase 4+)
FORECAST_ENGINES_ENABLED=ets,arima,prophet,lgbm,croston
SCORING_WEIGHT_MASE=0.6
SCORING_WEIGHT_GUARDRAIL=0.3
SCORING_WEIGHT_FIT=0.1
BACKTEST_MIN_PERIODS=12
ENGINE_TIMEOUT_SECONDS=45
FORECAST_TIMEOUT_SECONDS=120

# Database (Fase 1+)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/forecastiq

# Supabase (Fase 1+)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (Fase 3+)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=forecastiq-bucket
